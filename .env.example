# Copy to .env and fill in. The server boots with these blanks.
# Google sign-in returns 503 until GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET,
# and a SESSION_SECRET of at least 32 characters are set.
# Leave DATABASE_URL empty to store users in data/store.json.
# Set it to a TigerData (Postgres) URL to use that instead.

PORT=8787
PUBLIC_BASE_URL=http://127.0.0.1:8787

# Web application OAuth client. Not the desktop client baked into the Tauri app.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# HMAC secret for Waypoint access tokens. At least 32 characters.
SESSION_SECRET=

# postgres://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL=

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Extra browser origins, comma-separated. localhost and tauri://localhost are already allowed.
WAYPOINT_CORS_ORIGINS=

# Leave these blank to append login codes to data/outbox.jsonl (local dev only).
# Set all five to send the code over SMTP instead.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
