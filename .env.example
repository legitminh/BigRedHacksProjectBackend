# Copy to .env and fill in. The server boots with these blanks.
# Google sign-in returns 503 until GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET,
# and a SESSION_SECRET of at least 32 characters are set.
# Leave DATABASE_URL empty to store users in data/store.json.
# Set it to a TigerData (Postgres) URL to use that instead.

PORT=8787
# Keep 127.0.0.1 when nginx/Caddy on the same host proxies to this port (recommended).
# Only use 0.0.0.0 if the API is on a different host — and firewall :8787 from the public internet.
BIND_HOST=127.0.0.1
# Public HTTPS URL clients use (must match Google OAuth redirect URIs).
PUBLIC_BASE_URL=http://127.0.0.1:8787

# Web application OAuth client — lives ONLY on this server (never in the Mac app).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# HMAC secret for Waypoint access tokens. At least 32 characters.
SESSION_SECRET=

# TigerData / Tiger Cloud (required for multi-device sync):
# 1) https://console.cloud.tigerdata.com → New service (Shared/Dev is fine)
# 2) Download the config immediately (password shown only once)
# 3) Paste:
#    DATABASE_URL=postgresql://tsdbadmin:PASSWORD@HOST:PORT/tsdb?sslmode=require
# 4) Restart API; GET /health must show "storage":"postgres"
# Leave empty to use local data/store.json (single machine only).
DATABASE_URL=

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Extra browser origins, comma-separated. localhost and tauri://localhost are already allowed.
WAYPOINT_CORS_ORIGINS=

# Leave these blank to append login codes to data/outbox.jsonl (local dev only).
# Set all five to send the code over SMTP instead.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Long-lived Gemini key. Stays on this server only — never bake into Waypoint.app.
# Copilot / companion HTTP text chat → REST generateContent (GEMINI_MODEL).
GEMINI_API_KEY=
# Free-tier workhorse for Copilot. Flash-Lite has the highest free RPD; full Flash is often ~20/day.
# Google pointed retired 2.0-flash-lite traffic here. Alias: gemini-flash-lite-latest.
GEMINI_MODEL=gemini-3.5-flash-lite
# Deeper REST model for DEEP BRIEF / FULL CONTENTS and exhaustive list asks (default: gemini-3.5-flash).
GEMINI_OVERVIEW_MODEL=gemini-3.5-flash
# Voice companion Live only (WS /v1/companion/live, AUDIO). Not used for HTTP Copilot.
# Desktop never holds this key — only the API opens the Google Live socket.
GEMINI_LIVE_MODEL=gemini-3.8-live
# Current desktop sends the JWT as Sec-WebSocket-Protocol "bearer.<jwt>" (never in the URL).
# Set to 0 in production to reject deprecated ?access_token= / ?token= (leaks into proxy logs).
# Default (unset) stays on for older clients.
LIVE_ALLOW_QUERY_TOKEN=
# LEGACY: expose POST /v1/session/ephemeral-token (client-side Gemini Live). Default OFF (404).
# The desktop uses the server-side Live proxy instead. Set to 1 only for older clients.
ENABLE_EPHEMERAL_TOKEN=

# xAI / Grok Text-to-Speech for study heads-up / nudge audio (POST /v1/voice/tts).
# Stays on this server only — never bake into Waypoint.app.
# Desktop falls back to macOS `say` within ~4s if this is blank, unreachable, or slow.
# Get a key: https://console.x.ai/ → API keys. Docs: https://docs.x.ai/developers/model-capabilities/audio/text-to-speech
XAI_API_KEY=
# Built-in voice id (eve default; also ara, rex, sal, … — see xAI TTS voices).
XAI_TTS_VOICE=eve

# Presage Technologies API key for camera accountability (POST /v1/camera/observe).
# Stays on this server only — never bake into Waypoint.app.
# When set: short video clips → vitals.stressed (stress_index > 150 or HRV/RMSSD < 20)
# then active-phase nudge.kind=suggest_break (optional five-minute invite; never auto-starts).
# When unset or Presage fails: vitals=null / no stress nudge (documented fallback — desktop may
# use local VIDEOINPUT cues separately). Observe still runs presence heuristics (~25s/user floor).
PRESAGE_API_KEY=

# Copilot chat provider for local vs cloud:
#   gemini | cloud  — Gemini first; silent Ollama fallback on quota/outage (default; cloud companion)
#   ollama | llama | local — always Ollama; never calls Gemini for chat
LOCAL_CHAT_PROVIDER=gemini

# Ollama runs on this machine (or a GPU host), not on end-user Macs.
# Desktop app calls POST/GET /v1/coach/api/* which proxy here.
# Omit the variable to default to http://127.0.0.1:11434; set empty to disable.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_VISION_MODEL=moondream
# Local Copilot model (LOCAL_CHAT_PROVIDER=ollama, or Gemini fallback). Quantized, long context.
# Pull once on the API host: ollama pull qwen2.5:7b
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_CHAT_NUM_CTX=16384
# Shared secret baked into the desktop app as coach_api_token (Bearer).
# Generate with: openssl rand -hex 24. JWT access tokens also work.
COACH_API_TOKEN=

# Local HTML admin console password (generate with: openssl rand -base64 48 | tr -dc A-Za-z0-9 | head -c 32)
ADMIN_PASSWORD=

# --- Abuse shields ---
# NODE_ENV=production refuses email sign-in unless SMTP_* + MAIL_FROM are all set.
# NODE_ENV=production
# Set to 1 ONLY behind a reverse proxy you control: per-IP rate limits then use the
# rightmost X-Forwarded-For hop. Unset (default) uses the socket address.
# TRUST_PROXY=1
# Extra Ollama models /v1/coach/api/generate may run (comma-separated). OLLAMA_MODEL,
# OLLAMA_VISION_MODEL and OLLAMA_CHAT_MODEL are always allowed.
# OLLAMA_ALLOWED_MODELS=
